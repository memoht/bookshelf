<!-- app/templates/books/show.html.erb -->
<div class="row mt-5 py-3">
  <div class="col-7">
    <table class="rows table table-striped">
      <thead>
        <tr>
          <th class="col-sm-2">Attribute</th>
          <th class="col-sm-10">Value</th>
        </tr>
      </thead>
      <% book.attributes.sort_by(&:first).to_h.each do |key, value| %>
        <tr>
          <td class="col-sm-2 fw-light"><%= key.downcase %></td>
          <td class="col-sm-10"><%= value.to_s %></td>
        </tr>
      <% end %>
    </table>
  </div>
  <div class="col-5">
    <% if book.isbn %>
      <div class="d-flex flex-column align-items-center justify-content-center h-100">
        <img src="<%= book.open_library_cover_url %>">
        <p>ISBN: <%= book.formatted_isbn %></p>
        <%= barcode.html_safe %>
      </div>
    <% end %>
  </div>
</div>
