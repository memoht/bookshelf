<!-- app/templates/books/show.html.erb -->

<table class="rows table table-striped">
  <% book.attributes.sort_by(&:first).to_h.each do |key, value| %>
    <tr>
      <td class="col-sm-2 fw-light"><%= key.downcase %></td>
      <td class="col-sm-10"><%= value.to_s %></td>
    </tr>
  <% end %>
</table>

<% if book.isbn %>
  <div class="isbn-section">
    <p>ISBN: <%= book.isbn %></p>
    <%= barcode.html_safe %>
  </div>
<% end %>
