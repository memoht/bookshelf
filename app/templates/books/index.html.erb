<!-- app/templates/books/index.html.erb -->

<h1 class="text-center mb-5">Books</h1>

<div class="container">

  <div class="row row-cols g-4 mb-4 border-bottom pb-4">
    <% books.each do |book| %>
      <div class="col">
        <div class="card" style="width: 16rem;">
          <img src="<%= asset_url("img-placeholder-cover.png") %>">
          <div class="card-body">
            <h5 class="card-title mb-0"><%= book[:title] %></h5>
            <p class="card-text"><%= book[:author] %></p>
            <%= link_to "Edit", routes.path(:edit_book, id: book[:id]) %>
            <%= book.inspect %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>


