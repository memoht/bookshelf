<!-- app/templates/books/new.html.erb -->

<h1>New book</h1>

<%= form_for :book, routes.path(:create_book) do |f| %>
  <div class="mb-3">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div class="mb-3">
    <%= f.label :author %>
    <%= f.text_field :author, class: "form control" %>
  </div>

  <div class="mb-3">
    <%= f.label :category %>
    <%= f.select :category, categories, class: "form-control"  %>
  </div>

  <div class="mb-3">
    <%= f.label :format %>
    <%= f.select :format, formats, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :isbn %>
    <%= f.text_field :isbn, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :publication_date %>
    <%= f.date_field :publication_date, class: "form-control"  %>
  </div>

  <div>
    <%= f.submit "Create", class: "btn btn-outline-primary" %>
  </div>
<% end %>

