<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookshelf</title>
    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>

  </head>
  <body class="d-flex flex-column h-100">
    <% if flash[:alert] %>
      <div class="alert alert-primary rounded-0" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="alert alert-info rounded-top" role="alert">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <div class="container-fluid">
      <%= yield %>
    </div>
    <footer class="position-fixed bottom-0 w-100">
      <%= render "navbar" %>
    </footer>
    <%= javascript_tag "app" %>
  </body>
</html>
